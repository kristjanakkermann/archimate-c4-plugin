%% Product Boundaries for Containers
%% Source: ARIS ArchiMate 3 model "Product boundaries"
%% Render: npx tsx diagrams/mermaid/render-product-boundaries.ts
%%
%% Flow paths through the API Gateway:
%%   A calls B: Application A-API -> App B route in GW -> Application B-API
%%   B calls A: Application B-API -> App A route in GW -> Application A-API

graph LR

    subgraph product_a[IT Product A]
        subgraph app_a[Application A · Software System]
            a_api[Application A-API · Container]
        end
    end

    subgraph api_gw[API xxx GW · Software System]
        b_route[App B route in GW · Container]
        a_route[App A route in GW · Container]
    end

    subgraph product_b[IT Product B]
        subgraph app_b[Application B · Software System]
            b_api[Application B-API · Container]
        end
    end

    a_api -.->|exchanges info| b_route
    a_api -.->|exchanges info| a_route
    b_route -.->|exchanges info| b_api
    a_route -.->|exchanges info| b_api
